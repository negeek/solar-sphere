# For local `go run .` dev (APP_ENV=dev). Copy to solar-sentinel/.env.
APP_ENV=dev
DATABASE_URL=mongodb://localhost:27017
DB_NAME=solarsphere
VERIFICATION_KEY=
BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=solar-sentinel-dev
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=solar-sphere/solar-sentinel/sensor/+/solar-irradiance
PORT=5000
LOG_LEVEL=debug
LOG_FORMAT=text
