# Copy this to .env and fill it in before running `docker compose up`.
#   cp .env.example .env

# --- Database (docker-compose's mongo service; "mongo" is its DNS name on
# the compose network) ---
DATABASE_URL=mongodb://mongo:27017
DB_NAME=solarsphere

# --- Access keys ---
# Generate a pair with:
#   go run ./solar-spectrum/cmd/keygen
SIGNING_KEY=
VERIFICATION_KEY=

# --- MQTT (docker-compose's mosquitto service) ---
BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=solar-sentinel
MQTT_USERNAME=
MQTT_PASSWORD=
# "+" matches every device's ID so one subscription covers all of them.
MQTT_TOPIC=solar-sphere/solar-sentinel/sensor/+/solar-irradiance

# --- Logging (optional; these are the defaults) ---
LOG_LEVEL=info
LOG_FORMAT=json
